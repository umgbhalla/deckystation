+def paste_modifier():
+    """Herdr's semantic paste is Super+V; games use Ctrl+V."""
+    try:
+        env = _clipboard_env()
+        focused = subprocess.check_output(
+            ["/usr/bin/xprop", "-display", ":0", "-root", "GAMESCOPE_FOCUSED_APP"],
+            text=True, timeout=1, stderr=subprocess.DEVNULL,
+            env=env, **_process_identity(env),
+        ).strip()
+        # shortcut: this installed Steam shortcut ID; update if Herdr is re-added.
+        return "125" if focused == "GAMESCOPE_FOCUSED_APP(CARDINAL) = 2380454464" else "29"
+    except (OSError, subprocess.SubprocessError):
+        return "29"
